# ChargeHA Environment Variables
# All other configuration (Tesla, Fronius, etc.) is managed via the Settings UI or Setup Wizard.

PORT=8000
DB_PATH=./data/chargeha.db

# Log verbosity: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Required for encrypting secrets stored in the database (Tesla credentials, Fronius passwords, etc.).
# Prefer ENCRYPTION_KEY_FILE in production so the key is not exposed by process/container inspection.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_FILE=
# Backwards-compatible fallback for development:
ENCRYPTION_KEY=

# Optional licensed vehicle imagery from IMAGIN.studio.
# Obtain the customer ID from your IMAGIN.studio account. Images are served directly
# from their CDN; E.V. Solar does not download or cache the provider assets server-side.
IMAGIN_CUSTOMER_ID=
# Freemium accounts are limited to 400px. Premium plans may use larger supported widths.
IMAGIN_IMAGE_WIDTH=400
